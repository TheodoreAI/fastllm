fastllm.exe
fastllm.exe~
fastllm-cli.exe
/fastllm
.fastllm.launched
fastllm.db
fastllm.db-shm
fastllm.db-wal
fastllm.log

# `go build ./...` from repo root writes each main package's binary here
# named after its directory (cmd/server -> server) when run without -o —
# easy to do by accident when cross-compile-checking all packages at once.
/server
.env
fastllm_terminal_test.exe

# Go build/test cache from running the suite with GOCACHE pointed at the repo
# (e.g. sandboxed `GOCACHE=.test-cache go test ./...`). Machine-local hashed
# objects, hundreds of MB — never a fixture, despite the name.
.test-cache/

# Local fastllm config. CandidateConfigPaths checks ./.fastllm/config.json
# before the one in $HOME, so a project-local config is what the TUI writes
# to — keep it out of the repo rather than trusting it to stay secret-free.
.fastllm/