# Default: let git normalize text in the repo, and check out native endings.
* text=auto

# Shell scripts are executed by an interpreter that treats CR as part of the
# command, so a CRLF checkout fails with "$'\r': command not found". These must
# always be LF, on every platform, regardless of core.autocrlf.
*.sh text eol=lf
*.go text eol=lf

# Windows-only scripts keep CRLF for the same reason in reverse.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binary content.
*.png binary
*.jpg binary
*.ico binary
*.gz binary
*.db binary
